# ============================================
# OpenNotebook AI - Environment Variables
# ============================================

# Copie este arquivo para .env e preencha com suas credenciais
# cp .env.example .env

# ============================================
# Supabase Configuration
# ============================================

# URL do seu projeto Supabase
# Encontre em: Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Chave anon pública do Supabase
# Encontre em: Settings → API → anon public
# IMPORTANTE: Use a chave anon, NÃO a service_role!
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# Optional: AI Provider API Keys
# ============================================

# Estas chaves são opcionais - os usuários podem configurar
# suas próprias chaves na interface do app

# OpenAI
# VITE_OPENAI_API_KEY=sk-...

# Anthropic
# VITE_ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
# VITE_GOOGLE_API_KEY=AI...

# Groq
# VITE_GROQ_API_KEY=gsk_...

# Mistral
# VITE_MISTRAL_API_KEY=...

# ============================================
# Development Settings
# ============================================

# Modo de desenvolvimento
VITE_DEV_MODE=false

# Log level (debug, info, warn, error)
VITE_LOG_LEVEL=info
